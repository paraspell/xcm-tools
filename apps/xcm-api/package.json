  "type": "module",
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "prisma generate && nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/main",
    "lint:check": "eslint src",
    "lint": "eslint --fix src",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org paraspell --project node ./dist && sentry-cli sourcemaps upload --org paraspell --project node ./dist"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@paraspell/descriptors": "workspace:*",
    "@paraspell/evm": "workspace:*",
    "@paraspell/evm-snowbridge": "workspace:*",
    "@paraspell/sdk": "workspace:*",
    "@paraspell/xcm-analyser": "workspace:*",
    "@paraspell/swap": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sentry/cli": "^3.6.2",
    "@sentry/nestjs": "^10.71.0",
    "@sentry/profiling-node": "^10.71.0",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.2.1",
    "googleapis": "^176.0.0",
    "mixpanel": "^0.23.0",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "polkadot-api": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ua-parser-js": "^2.0.10",
    "viem": "^2.55.19",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@swc/core": "^1.16.1",
