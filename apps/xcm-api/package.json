    "@sentry/cli": "^3.8.2",
    "@sentry/nestjs": "^11.10.0",
    "@sentry/profiling-node": "^11.10.0",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express": "^5.3.0",
    "googleapis": "^188.0.0",
    "mixpanel": "^0.24.0",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "polkadot-api": "^3.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
