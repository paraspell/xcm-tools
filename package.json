{
  "name": "paraspell",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.11",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "globals": "^17.14.0",
    "netlify-cli": "^27.20.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "compile": "turbo run compile",
    "format:check": "turbo run format:check",
    "format:write": "turbo run format:write",
    "lint:check": "turbo run lint:check",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:watch": "turbo run test:watch",
    "test:e2e": "turbo run test:e2e",
    "build": "turbo run build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build:apps": "pnpm --filter \"./apps/*\" build",
    "run:playground": "pnpm --filter playground dev",
    "run:api": "pnpm --filter xcm-api start:dev",
    "run:paraspell-site": "pnpm --filter site dev",
    "run:updateAssets": "pnpm --filter assets updateAssets",
    "run:updateRouterAssets": "pnpm --filter swap updateAssets",
    "run:updatePallets": "pnpm --filter pallets updatePallets"
  },
  "packageManager": "pnpm@12.23.0"
}
