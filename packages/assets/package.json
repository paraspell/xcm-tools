{
  "name": "@paraspell/assets",
  "version": "14.4.1",
  "description": "Assets for ParaSpell XCM/XCMP tool for developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paraspell/xcm-tools.git",
    "directory": "packages/assets"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "compile": "tsc --noEmit",
    "build": "rollup -c",
    "lint:check": "eslint src",
    "lint": "eslint --fix src",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "updateAssets": "tsx ./scripts/fetchAssets.ts"
  },
  "dependencies": {
    "@paraspell/sdk-common": "workspace:*"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-attributes": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@codecov/rollup-plugin": "^2.0.1",
    "@polkadot-api/metadata-builders": "^0.15.2",
    "@polkadot-api/substrate-bindings": "^0.21.2",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@snowbridge/registry": "^1.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "dotenv": "^18.0.4",
    "polkadot-api": "^3.2.0",
    "rollup": "^4.63.5",
    "rollup-plugin-dts": "^6.5.1",
    "tsx": "^4.23.15"
  }
}
